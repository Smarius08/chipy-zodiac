{
  "name": "chipy-zodiac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "fixtures": "python3 scripts/prepare_data.py",
    "preflight": "python3 scripts/preflight.py",
    "doctor": "python3 scripts/preflight.py && node scripts/browser-doctor.mjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory output",
    "test:smoke": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
